@inproceedings{jia2026context,
  title = {Improving Neural Decoding Performance for Language BCIs by Explicitly Modeling Context-Induced Noise},
  author = {Jia, Yao and Tan, Xianhan and Luo, Binli and Wang, Yueming and Qi, Yu},
  booktitle = {NeurIPS Poster},
  year = {2026},
  month = {dec},
  url = {https://neurips.cc/virtual/2026/loc/sydney/poster/148927},
  selected = {true},
  preview = {preview.webp},
  description = {Modeling how linguistic context changes neural activity improves decoding for speech and handwriting brain-computer interfaces.},
  description_zh = {建模语言上下文引起的神经活动变化，改善语音和手写脑机接口的解码表现。},
  abstract = {Language context can change the neural activity associated with the same phoneme or other linguistic unit. We separate context-dependent variation from stochastic noise and use the contextual component to distinguish similar units. Controlled comparisons across multiple datasets show improved decoding, and an integrated system is evaluated on the official Brain-to-Text Benchmark '24.},
  abstract_zh = {同一音素或其他语言单元在不同上下文中可能对应不同的神经活动。我们将上下文引起的变化与随机噪声分离，并利用上下文成分区分相似的语言单元。多个数据集上的受控比较显示了解码性能的改善，并在官方 Brain-to-Text Benchmark '24 上评估了集成系统。},
  keywords = {Language BCIs, Neural Decoding, Context-Induced Noise}
}
